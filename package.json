{
  "name": "staybridge-tokyo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @staybridge/user dev",
    "dev:user": "pnpm --filter @staybridge/user dev",
    "dev:municipality": "pnpm --filter @staybridge/municipality dev",
    "build": "pnpm --filter @staybridge/user run build && pnpm --filter @staybridge/municipality run build",
    "build:user": "pnpm --filter @staybridge/user run build",
    "build:municipality": "pnpm --filter @staybridge/municipality run build",
    "test": "pnpm run test:workflow && pnpm run test:workflows && pnpm run test:contrast && pnpm --filter @staybridge/domain --filter @staybridge/data --filter @staybridge/i18n --filter @staybridge/worker-runtime --filter @staybridge/user --filter @staybridge/municipality -r run test && pnpm run test:cd",
    "test:workflow": "node --test tests/assign-pr-people-workflow.test.mjs",
    "test:workflows": "node --test tests/github-actions-security.test.mjs",
    "test:contrast": "node --test tests/color-contrast.test.mjs",
    "test:cd": "node --test scripts/cd/*.test.mjs",
    "typecheck": "pnpm --filter @staybridge/domain --filter @staybridge/data --filter @staybridge/i18n --filter @staybridge/sites-vite-plugin --filter @staybridge/worker-runtime --filter @staybridge/user --filter @staybridge/municipality -r run typecheck",
    "lint": "pnpm --filter @staybridge/domain --filter @staybridge/data --filter @staybridge/i18n --filter @staybridge/sites-vite-plugin --filter @staybridge/worker-runtime --filter @staybridge/user --filter @staybridge/municipality -r run lint",
    "lint:fix": "pnpm --filter @staybridge/user --filter @staybridge/municipality -r run lint:fix",
    "test:rendered": "pnpm --filter @staybridge/user run test:rendered && pnpm --filter @staybridge/municipality run test:rendered",
    "data:fetch": "pnpm --filter @staybridge/data data:fetch"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.0",
    "@cloudflare/workers-types": "^5.20260820.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.124.0"
  },
  "type": "module",
  "packageManager": "pnpm@10.15.1"
}
