{
  "name": "staybridge-tokyo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "vitest run --config vitest.config.ts && pnpm run test:workflow && pnpm run test:workflows && pnpm run test:rendered",
    "test:workflow": "node --test tests/assign-pr-people-workflow.test.mjs",
    "test:workflows": "node --test tests/github-actions-security.test.mjs",
    "test:rendered": "pnpm run build && node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "data:fetch": "tsx scripts/fetch-open-data.ts"
  },
  "dependencies": {
    "next": "^16.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.0",
    "@cloudflare/workers-types": "^5.20260819.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vinext": "0.2.1",
    "vite": "8.2.1",
    "vitest": "^4.1.11",
    "wrangler": "4.124.0"
  },
  "type": "module",
  "packageManager": "pnpm@10.15.1"
}
