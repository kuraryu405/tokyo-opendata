{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "staybridge-user-local",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "SUPPORT_CHAT_RATE_LIMITER",
      "namespace_id": "202608230020",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "AI_USER_RATE_LIMITER",
      "namespace_id": "20260823005601",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "AI_GLOBAL_RATE_LIMITER",
      "namespace_id": "20260823005602",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "STAYBRIDGE_DB",
      "database_name": "staybridge-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "../../database/migrations",
      "remote": false
    }
  ],
  "env": {
    "staging": {
      "name": "staybridge-user-staging",
      "ai": {
        "binding": "AI"
      },
      "ratelimits": [
        {
          "name": "SUPPORT_CHAT_RATE_LIMITER",
          "namespace_id": "202608230020",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "AI_USER_RATE_LIMITER",
          "namespace_id": "20260823005601",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "AI_GLOBAL_RATE_LIMITER",
          "namespace_id": "20260823005602",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "d1_databases": [
        {
          "binding": "STAYBRIDGE_DB",
          "database_name": "staybridge-staging",
          "database_id": "00000000-0000-4000-8000-000000000002",
          "migrations_dir": "../../database/migrations"
        }
      ]
    },
    "production": {
      "name": "staybridge-user-production",
      "ai": {
        "binding": "AI"
      },
      "ratelimits": [
        {
          "name": "SUPPORT_CHAT_RATE_LIMITER",
          "namespace_id": "202608230020",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "AI_USER_RATE_LIMITER",
          "namespace_id": "20260823005601",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "AI_GLOBAL_RATE_LIMITER",
          "namespace_id": "20260823005602",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "d1_databases": [
        {
          "binding": "STAYBRIDGE_DB",
          "database_name": "staybridge-production",
          "database_id": "00000000-0000-4000-8000-000000000003",
          "migrations_dir": "../../database/migrations"
        }
      ]
    }
  }
}
