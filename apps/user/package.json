{
  "name": "@staybridge/user",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --port 3000",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start --port 3000",
    "test": "node --test tests/static-assets.test.mjs && vitest run --config vitest.config.ts && pnpm run test:rendered && pnpm run test:mobile-layout",
    "test:rendered": "pnpm run build && node --test tests/rendered-html.test.mjs",
    "test:mobile-layout": "node --test tests/mobile-layout.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../.oxlintrc.json --deny-warnings",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --fix"
  },
  "dependencies": {
    "@staybridge/data": "workspace:*",
    "@staybridge/domain": "workspace:*",
    "@staybridge/i18n": "workspace:*",
    "@staybridge/ui": "workspace:*",
    "@staybridge/worker-runtime": "workspace:*",
    "next": "^16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.0",
    "@cloudflare/workers-types": "^5.20260820.1",
    "@staybridge/sites-vite-plugin": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.124.0"
  },
  "type": "module"
}
