{
  "name": "@staybridge/user",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --port 3000",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start --port 3000",
    "test": "vitest run --config vitest.config.ts && pnpm run test:rendered",
    "test:rendered": "pnpm run build && node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../.oxlintrc.json --deny-warnings",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --fix"
  },
  "dependencies": {
    "@staybridge/data": "workspace:*",
    "@staybridge/domain": "workspace:*",
    "@staybridge/i18n": "workspace:*",
    "next": "^16.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@staybridge/sites-vite-plugin": "workspace:*",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "^30.0.1",
    "oxlint": "^1.78.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
