{
  "name": "@staybridge/municipality",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --port 3001",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start --port 3001",
    "test": "node --test tests/static-assets.test.mjs && pnpm run test:styles && pnpm --filter @staybridge/worker-runtime run test && pnpm vitest run --config vitest.config.ts && pnpm run test:rendered",
    "test:styles": "node --test tests/shared-styles.test.mjs",
    "test:rendered": "pnpm run build && node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../.oxlintrc.json --deny-warnings",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --fix"
  },
  "dependencies": {
    "@staybridge/data": "workspace:*",
    "@staybridge/ui": "workspace:*",
    "@staybridge/worker-runtime": "workspace:*",
    "next": "^16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/workers-types": "^5.20260825.1",
    "@staybridge/sites-vite-plugin": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.80.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "0.2.1",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.125.0"
  },
  "type": "module"
}
